<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Bimtech.RevitMcp.Addin</AssemblyName>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <!-- Revit provides these assemblies at runtime. Do not copy them to the add-in. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Structural modeling core shared with the BIMTECH WPF hot tools (repo RevitAddinManager).
       Source files are compiled into this add-in; see StructuralCore.props for why. -->
  <PropertyGroup>
    <!-- Embeds the company default families (e.g. the concrete column family) for load_default_column_family. -->
    <StructuralCoreEmbedFamilies>true</StructuralCoreEmbedFamilies>
    <StructuralCoreDir Condition="'$(StructuralCoreDir)' == ''">$(MSBuildThisFileDirectory)..\..\RevitAddinManager\Tools\_Shared\StructuralCore\</StructuralCoreDir>
  </PropertyGroup>
  <Import Project="$(StructuralCoreDir)StructuralCore.props" Condition="Exists('$(StructuralCoreDir)StructuralCore.props')" />

  <Target Name="ValidateStructuralCore" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(StructuralCoreDir)StructuralCore.props')" Text="Structural core not found at $(StructuralCoreDir). Clone RevitAddinManager next to this repo or set StructuralCoreDir." />
  </Target>

  <Target Name="ValidateRevitLocation" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Revit 2025 API not found. Set RevitInstallDir to your Revit installation folder." />
  </Target>
</Project>
