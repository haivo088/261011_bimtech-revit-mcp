<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Bimtech.RevitMcp.Addin</AssemblyName>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <!-- Revit provides these assemblies at runtime. Do not copy them to the add-in. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Structural modeling core (StructuralCore\), copied from RevitAddinManager at f2db0d5 and now
       maintained here. Its .cs files compile in through the SDK's default glob. The company default
       families are embedded under the resource names DefaultFamilies expects. -->
  <ItemGroup>
    <EmbeddedResource Include="StructuralCore\Families\*.rfa"
                      LogicalName="Bimtech.StructuralCore.Families.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateRevitLocation" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Revit 2025 API not found. Set RevitInstallDir to your Revit installation folder." />
  </Target>
</Project>
