<Window x:Class="Bimtech.RevitMcp.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMTECH MCP - Cài đặt"
        Width="680" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#1E3A52"/>
        <SolidColorBrush x:Key="Teal" Color="#17708A"/>
        <SolidColorBrush x:Key="Muted" Color="#5B6B78"/>
        <SolidColorBrush x:Key="Line" Color="#D5DDE3"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Teal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="BIMTECH MCP" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Foreground="#C9D6E0" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,4,20,12">
                <Border x:Name="ProblemBanner" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#E0A94A"
                        BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Chế độ" Style="{StaticResource SectionTitle}"/>
                <CheckBox x:Name="ReadOnlyCheck" Content="Chế độ chỉ đọc - chặn mọi lệnh sửa hoặc xóa model"
                          FontWeight="SemiBold" Checked="OnReadOnlyChanged" Unchecked="OnReadOnlyChanged"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                           Text="Nên bật khi mở model dự án thật. Claude vẫn đọc dữ liệu và xem trước kế hoạch (dry-run), nhưng không ghi được gì."/>

                <CheckBox x:Name="CommitOnApproveCheck" Content="Bấm Duyệt kế hoạch là ghi vào mô hình ngay" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                           Text="Không cần quay lại nói với Claude: các mục đã duyệt được ghi ngay khi bạn bấm Duyệt kế hoạch, là một bước Ctrl+Z. Tắt đi thì Claude ghi khi bạn báo xong."/>

                <CheckBox x:Name="AutoCommitCheck" Content="Tự commit kế hoạch khi mọi mục đủ tin cậy" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                           Text="Kế hoạch mà mọi mục từ 50% tin cậy trở lên, không có mục bị chặn, được duyệt thay bạn ngay khi đề xuất: Claude ghi luôn, không mở cửa sổ duyệt. Vẫn là một bước Ctrl+Z. Kế hoạch có mục cần xem vẫn chờ bạn duyệt."/>

                <TextBlock Text="Cầu nối" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cổng TCP" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox x:Name="PortBox" Width="90" Padding="4,2"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="1024 - 65535. Server đọc cùng file nên không cần sửa ở nơi khác."/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Giới hạn phần tử mỗi lần ghi" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <TextBox x:Name="MaxElementsBox" Width="90" Padding="4,2"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="Ví dụ số cột tối đa một lần place_columns."/>
                    </StackPanel>
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoStartCheck" Margin="0,8,0,0"
                              Content="Tự bật cầu nối khi mở Revit"/>
                </Grid>

                <TextBlock Text="Lệnh cho Claude" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Bỏ chọn để Claude không thấy và không gọi được lệnh đó. Thay đổi có hiệu lực ngay, không cần tắt cầu nối."/>
                <DataGrid x:Name="CommandGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                          BorderBrush="{StaticResource Line}" RowHeaderWidth="0" SelectionMode="Single">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Teal}"
                                               Margin="6,10,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Bật" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanToggle}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Lệnh" Binding="{Binding Method}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quyền" Binding="{Binding AccessLabel}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="200" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="FilePathText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Bật tất cả lệnh" Style="{StaticResource SecondaryButton}"
                        Click="OnEnableAll"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
