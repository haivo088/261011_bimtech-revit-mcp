<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Compiles the add-in's Revit-free sources directly, so the tests run without Revit installed. -->
  <ItemGroup>
    <Compile Include="..\..\addin\Planning\Plan.cs" Link="Linked\Plan.cs" />
    <Compile Include="..\..\addin\Planning\PlanService.cs" Link="Linked\PlanService.cs" />
    <Compile Include="..\..\addin\Planning\PlanStore.cs" Link="Linked\PlanStore.cs" />
    <Compile Include="..\..\addin\Planning\PlanCommitter.cs" Link="Linked\PlanCommitter.cs" />
    <Compile Include="..\..\addin\Planning\PlanHistory.cs" Link="Linked\PlanHistory.cs" />
    <Compile Include="..\..\addin\Protocol\RpcException.cs" Link="Linked\RpcException.cs" />
    <!-- How propose_change_type sorts elements into review items. -->
    <Compile Include="..\..\addin\Commands\Elements\TypeChangeGroups.cs" Link="Linked\TypeChangeGroups.cs" />
    <!-- The review window's view model uses no WPF or Revit types. -->
    <Compile Include="..\..\addin\Ui\ReviewViewModel.cs" Link="Linked\ReviewViewModel.cs" />
    <Compile Include="..\..\addin\Ui\PlanItemRow.cs" Link="Linked\PlanItemRow.cs" />
    <Compile Include="..\..\addin\Ui\PreviewShapes.cs" Link="Linked\PreviewShapes.cs" />
    <!-- Clean data from outside Revit (grid/1.0): reader, layout and review items use no Revit types. -->
    <Compile Include="..\..\addin\Data\*.cs" Link="Linked\Data\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A real grid/1.0 file produced by the extraction pipeline (MB_KC_Tang2, 17 grids). -->
  <ItemGroup>
    <None Include="Data\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
</Project>
